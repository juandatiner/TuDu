# Credenciales del CLI de Supabase. Copiar a `.env.local` y llenar.
#
# `.env.local` está en el .gitignore de supabase/, así que no se commitea.
# Se llena UNA vez: después `./supabase/db-push.sh` aplica migrations sin
# pedir token ni contraseña por consola.

# Personal access token del CLI.
# Dashboard → arriba a la derecha (tu avatar) → Account → Access Tokens
# → Generate new token. Empieza por `sbp_`.
SUPABASE_ACCESS_TOKEN=sbp_...

# Contraseña de la base de datos del proyecto (NO la del dashboard).
# Dashboard → Project Settings → Database → Database password.
# Si no la tenés a mano, ahí mismo se puede resetear.
SUPABASE_DB_PASSWORD=...

# Ref del proyecto — solo se usa si se pierde el link local.
SUPABASE_PROJECT_REF=msrxypywserfumscvnel
